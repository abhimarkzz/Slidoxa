# Slidoxa release hygiene — reproducible build artifacts, not source.
# These paths are regenerated by electron/scripts/*, npm run build:fastapi
# and docker compose builds; they must not be tracked. Only ignores
# future adds; existing tracked paths need `git rm --cached` separately.
electron/dist/
electron/resources/fastapi/
electron/resources/chromium/
electron/resources/export/node_modules/
electron/resources/imagemagick/
electron/resources/nextjs/
electron/app_dist/
packages/frontend/.next-build/
packages/backend/app/legacy/fastembed_cache/
servers/fastapi/fastembed_cache/
